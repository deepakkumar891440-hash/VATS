<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vats Notebook</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: #333;
        }
        .notebook-container {
            width: 90%;
            max-width: 700px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border: 1px solid #ddd;
        }
        .notebook-header {
            background: #4a90e2;
            color: white;
            padding: 20px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            letter-spacing: 1px;
        }
        .notebook-body {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        textarea {
            width: 100%;
            height: 350px;
            padding: 15px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 8px;
            resize: none;
            line-height: 1.5;
            outline: none;
            background: #fffdf9;
            background-image: linear-gradient(#eee 1px, transparent 1px);
            background-size: 100% 24px;
        }
        textarea:focus {
            border-color: #4a90e2;
        }
        .btn-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        button {
            background: #4a90e2;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.3s;
        }
        button:hover {
            background: #357abd;
        }
        #status {
            font-size: 14px;
            color: #27ae60;
            font-weight: 500;
        }
    </style>
</head>
<body>

    <div class="notebook-container">
        <div class="notebook-header">
            📖 Vats Notebook
        </div>
        <div class="notebook-body">
            <textarea id="noteInput" placeholder="Yahan apne notes likhein... (Yeh automatic save ho jayenge)"></textarea>
            <div class="btn-container">
                <span id="status"></span>
                <button onclick="saveNote()">Save Note</button>
            </div>
        </div>
    </div>

    <script>
        const noteInput = document.getElementById('noteInput');
        const status = document.getElementById('status');

        // Page khulte hi purana note load karna
        window.onload = function() {
            if(localStorage.getItem('vatsNotebookData')) {
                noteInput.value = localStorage.getItem('vatsNotebookData');
            }
        };

        // Note save karne ka function
        function saveNote() {
            localStorage.setItem('vatsNotebookData', noteInput.value);
            status.innerText = "Note Saved Successfully! ✓";
            setTimeout(() => {
                status.innerText = "";
            }, 3000);
        }
    </script>

</body>
</html>